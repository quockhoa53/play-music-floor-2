# ===== Cấu hình Database Supabase (Chọn 1 trong 2 cách bên dưới) =====

# CÁCH 1 (Khuyên dùng - Tự động tạo bảng khi khởi động):
# Lấy từ Supabase Dashboard -> Connect -> Transaction Pooler / Session Pooler (URI)
# DATABASE_URL=postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# CÁCH 2 (Dùng Supabase REST API — cần chạy file supabase_schema.sql 1 lần trong SQL Editor):
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Lấy Secret Key tại Supabase Dashboard -> Project Settings -> API Keys -> Secret key (sb_secret_...)
# SUPABASE_SECRET_KEY=sb_secret_...

# Nếu bỏ trống cả DATABASE_URL và SUPABASE_SECRET_KEY, ứng dụng tự lưu bền vững vào SQLite local: data/floor2.db

# Tuỳ chọn: proxy dân dụng nếu YouTube chặn IP datacenter trên Render cho luồng audio fallback
# YT_PROXY=http://user:pass@host:port

# ===== Keep-alive đánh thức server Render Free (giống songngu-sub) =====
# Tự động ping /api/health mỗi 8 phút để server không ngủ (15 phút trên Render Free).
# Ưu tiên URL: APP_SERVER_PUBLIC_URL > KEEP_ALIVE_URL > RENDER_EXTERNAL_URL (trống = tự tắt ở local).
# KEEP_ALIVE_EXTRA_URLS: các service Render khác (ngăn cách dấu phẩy) để 2 server giữ nhau thức!
# KEEP_ALIVE_ENABLED=true
# APP_SERVER_PUBLIC_URL=https://play-music-floor-2.onrender.com
# KEEP_ALIVE_EXTRA_URLS=https://sub-songngu.onrender.com

# ===== Chống tấn công DDoS tầng ứng dụng (L7) =====
# Mặc định bật (true). Đặt false chỉ khi cần tắt để benchmark tải.
# DDOS_GUARD_ENABLED=true
